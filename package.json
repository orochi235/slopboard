{
  "name": "slopboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n daemon,client -c cyan,magenta \"npm:dev:daemon\" \"npm:dev:client\"",
    "dev:daemon": "tsx watch server/index.ts",
    "dev:client": "vite",
    "sim": "tsx server/sim.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@weasel-js/core": "^1.4.4",
    "@weasel-js/ui": "^1.4.4",
    "chokidar": "^4.0.3",
    "delamin8r": "file:../delamin8r",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2",
    "three": "^0.169.0",
    "windease": "file:../windease",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
