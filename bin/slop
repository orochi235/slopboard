#!/bin/sh
# Put an image on the slopboard wall.
#
#   slop FILE...              zone defaults to the repo directory name
#   slop --zone Z FILE...
#   slop --ttl 5m FILE...      how long it lives; bare number is seconds
#   slop --caption "what it shows" FILE
#   slop --attention look FILE   asks to be looked at. Levels: look, soon,
#                                urgent, problem. Also `look:90s`, `30m`,
#                                `until-dismissed`.
#   slop --note "what it needs" FILE   badge text on a flagged card
#   slop clip.mp4             video too: the card is a poster frame and the
#                             lightbox plays it. Needs ffmpeg.
#   slop --sandbox "allow-scripts allow-forms" PAGE.html
#                                what an HTML page may do in the lightbox.
#                                `none` removes the sandbox entirely. Whoever
#                                pushes the page decides this; the wall
#                                applies what it is told.
#   slop --ask "which crop reads better?" --choice left --choice right FILE
#                             asks on the card and waits for the answer, then
#                             prints it. No --choice is a free-text answer.
#                             Exits 3 if the question is dismissed, 4 if the
#                             card is expired first. Run it in the background.
#   slop --wait PATH          waits on a question already sent, by the path
#                             `slop --ask` printed
#   some-generator | slop     reads stdin, writes a .png
#   slop --print-zone         prints the zone this repo resolves to, and exits
#
# Writing the file is the whole protocol; there is nothing to start or connect to.
# Provenance rides in a `<image>.slop.json` sidecar the daemon folds into the
# image's own metadata: the caption, plus the repo and commit this ran in. The
# sidecar is written first, because the image landing is what the daemon
# triggers on.
set -eu

# What the wall holds, matching server/kind.ts — held to it by kind.test.ts.
# Anything else is never adopted, so accepting it here would produce exactly the
# silently invisible artifact the ingest contract exists to prevent.
held_ext="png jpg jpeg webp gif avif tiff html htm mp4 m4v mov webm"
# Of those, the ones the daemon needs ffmpeg to turn into a poster frame. A
# video sent to a machine without it would be adopted by nothing and expired by
# nothing either, which is the silently invisible artifact this check exists to
# prevent — the same reason the extension check is here and not at ingest.
video_ext="mp4 m4v mov webm"

# JSON string escaping, for text that may hold a quote, a backslash or a
# newline. The awk joins lines with a literal \n, since sed works a line at a time.
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'
}

zone=""
ttl=""
caption=""
attention=""
note=""
sandbox=""
question=""
choices=""
wait_for=""
[ -n "${SLOP_ZONE:-}" ] && zone="$SLOP_ZONE"
while :; do
  case "${1:-}" in
    --zone) zone="$2"; shift 2 ;;
    --ttl) ttl="$2"; shift 2 ;;
    --caption) caption="$2"; shift 2 ;;
    --attention) attention="$2"; shift 2 ;;
    --note) note="$2"; shift 2 ;;
    --sandbox) sandbox="$2"; shift 2 ;;
    --ask) question="$2"; shift 2 ;;
    --choice) choices="$choices${choices:+,}\"$(json_escape "$2")\""; shift 2 ;;
    --wait) wait_for="$2"; shift 2 ;;
    *) break ;;
  esac
done
# A dot-segment before the extension, which is where the daemon looks.
# Not `[ -n ... ] && ...`: that returns non-zero when unset, and set -e exits.
suffix=""
if [ -n "$ttl" ]; then suffix=".ttl$ttl"; fi
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
repo=$(basename "$root")
sha=$(git rev-parse --short HEAD 2>/dev/null || true)
if [ -z "$zone" ]; then
  # printf, not a bare pipe: tr -c would turn basename's trailing newline into a
  # separator character and silently bind the repo to a second, adjacent zone.
  zone=$(printf '%s' "$repo" | tr -c 'A-Za-z0-9._-' '-')
fi

ext_of() {
  e="${1##*.}"
  case "$e" in "$1") e=png ;; esac
  printf '%s' "$e" | tr 'A-Z' 'a-z'
}


# Beside the image and before it: the daemon triggers on the image arriving, so
# a sidecar written afterwards is a race it would lose.
write_sidecar() {
  dest_image=$1
  dest_caption=$2
  [ -z "$dest_caption" ] && [ -z "$sha" ] && [ -z "$attention" ] && [ -z "$note" ] && [ -z "$sandbox" ] && [ -z "$question" ] && return 0
  {
    printf '{"repo":"%s"' "$(json_escape "$repo")"
    [ -n "$sha" ] && printf ',"sha":"%s"' "$(json_escape "$sha")"
    [ -n "$dest_caption" ] && printf ',"caption":"%s"' "$(json_escape "$dest_caption")"
    [ -n "$attention" ] && printf ',"attention":"%s"' "$(json_escape "$attention")"
    [ -n "$note" ] && printf ',"note":"%s"' "$(json_escape "$note")"
    [ -n "$sandbox" ] && printf ',"sandbox":"%s"' "$(json_escape "$sandbox")"
    [ -n "$question" ] && printf ',"question":"%s"' "$(json_escape "$question")"
    [ -n "$question" ] && [ -n "$choices" ] && printf ',"choices":[%s]' "$choices"
    printf '}\n'
  } > "$dest_image.slop.json"
}

if [ "${1:-}" = "--print-zone" ]; then echo "$zone"; exit 0; fi

slop_root="${SLOP_ROOT:-$HOME/slop}"

# The daemon writes the answer to answers/<the name slop gave the file>: the
# status on the first line, the answer after it.
await_answer() {
  answer="$slop_root/answers/$(basename "$1")"
  while [ ! -f "$answer" ]; do sleep 1; done
  status=$(head -n 1 "$answer")
  tail -n +2 "$answer"
  rm -f "$answer"
  case "$status" in
    answered) printf '\n'; exit 0 ;;
    dismissed) echo "slop: dismissed without an answer" >&2; exit 3 ;;
    *) echo "slop: the card was expired before it was answered" >&2; exit 4 ;;
  esac
}

if [ -n "$wait_for" ]; then await_answer "$wait_for"; fi
if [ -n "$question" ] && [ $# -gt 1 ]; then
  echo "slop: --ask takes one file, since one answer comes back" >&2
  exit 1
fi
if [ -z "$question" ] && [ -n "$choices" ]; then
  echo "slop: --choice needs --ask" >&2
  exit 1
fi
dir="$slop_root/inbox/$zone"
mkdir -p "$dir"

# Where this zone's renders come from, so the daemon can find the project's
# `.hued` and color the zone. One file per zone, rewritten on every send: a
# shared registry would be a read-modify-write that two concurrent sends lose.
zones_dir="$slop_root/zones"
mkdir -p "$zones_dir"
tmp="$zones_dir/.$zone.$$"
printf '{"root":"%s"}\n' "$(json_escape "$root")" > "$tmp" && mv "$tmp" "$zones_dir/$zone.json"

if [ $# -eq 0 ]; then
  dest="$dir/$(uuidgen)$suffix.png"
  write_sidecar "$dest" "$caption"
  cat > "$dest"
  echo "$dest"
  [ -n "$question" ] && await_answer "$dest"
  exit 0
fi

# A whole pass before the first copy, so a bad argument at the end of the list
# cannot leave the earlier ones half-sent.
for f in "$@"; do
  [ -f "$f" ] || { echo "slop: no such file: $f" >&2; exit 1; }
  ext=$(ext_of "$f")
  case " $held_ext " in
    *" $ext "*) ;;
    *) echo "slop: the wall does not hold .$ext ($f). It holds: $held_ext" >&2; exit 1 ;;
  esac
  case " $video_ext " in
    *" $ext "*)
      command -v ffmpeg >/dev/null 2>&1 || {
        echo "slop: .$ext needs ffmpeg for the poster frame ($f). brew install ffmpeg" >&2
        exit 1
      } ;;
  esac
done

for f in "$@"; do
  ext=$(ext_of "$f")
  dest="$dir/$(uuidgen)$suffix.$ext"
  # The destination name is a UUID, so without this the source name — the only
  # caption most renders have — is lost at the copy.
  if [ -n "$caption" ]; then
    own=$caption
  else
    own=$(basename "$f"); own="${own%.*}"
  fi
  write_sidecar "$dest" "$own"
  cp "$f" "$dest"
  echo "$dest"
  # An if, not `[ -n ... ] &&`: as the loop's last command, a false test would
  # be the script's exit status, and every send without --ask reported failure.
  if [ -n "$question" ]; then await_answer "$dest"; fi
done
